# ===========================================
# WG-Easy + Traefik Configuration
# Copy this file to .env and adjust values
# ===========================================

# REQUIRED: Your domain name (must point to this server)
DOMAIN=vpn.example.com

# REQUIRED: Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@example.com

# REQUIRED: Admin password for WG-Easy web UI
INIT_PASSWORD=your-secure-password-here

# Admin username (default: admin)
INIT_USERNAME=admin

# ===========================================
# Network Configuration
# ===========================================

# WireGuard UDP port (clients connect here)
WG_PORT=51820

# DNS servers for VPN clients (comma-separated)
INIT_DNS=1.1.1.1, 8.8.8.8

# VPN subnet for clients
INIT_IPV4_CIDR=10.8.0.x/24
INIT_IPV6_CIDR=fdcc:ad94:bacf:61a3::x/64

# Allowed IPs (what traffic goes through VPN)
# 0.0.0.0/0 = all traffic (full tunnel)
INIT_ALLOWED_IPS=0.0.0.0/0, ::/0

# ===========================================
# Optional Settings
# ===========================================

# Disable IPv6 support
DISABLE_IPV6=false

# Enable unattended setup (set to false after first run)
INIT_ENABLED=true

# ===========================================
# Traefik Dashboard (optional)
# ===========================================
# To enable dashboard, generate auth with:
#   echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g
# Then set:
# TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$...hashed...
